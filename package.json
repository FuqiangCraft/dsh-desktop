{
  "name": "deepseek-harness-desktop-pro",
  "version": "1.0.5",
  "private": true,
  "description": "The Ultimate Next-Generation Desktop Plugin & Native Client for DeepSeek Harness",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:electron": "pnpm --filter @dsh-community/dsh-desktop-electron dev",
    "dev:plugin": "pnpm --filter @mixian/dsh-desktop-plugin dev",
    "dev": "pnpm --dir packages/dsh-desktop-electron exec electron .",
    "electron:typecheck": "pnpm --dir packages/dsh-desktop-electron typecheck",
    "electron:test": "pnpm --dir packages/dsh-desktop-electron test",
    "electron:build": "pnpm --dir packages/dsh-desktop-electron build",
    "electron:package": "pnpm --dir packages/dsh-desktop-electron package:dir",
    "lint": "oxlint --ignore-pattern '**/lib/**' --ignore-pattern '**/target/**' .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "node --test test/license.test.mjs test/metadata.test.mjs packages/dsh-desktop-plugin/test/locales.test.mjs packages/dsh-desktop-plugin/test/config.test.mjs packages/dsh-desktop-plugin/test/screen-capture.test.mjs packages/dsh-desktop-plugin/test/notifier.test.mjs packages/dsh-desktop-plugin/test/settings.test.mjs packages/dsh-desktop-plugin/test/pet-state.test.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm electron:typecheck && pnpm electron:test && pnpm electron:build && pnpm --filter @mixian/dsh-desktop-plugin build && pnpm verify:bundle"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "desktop",
    "raycast",
    "agent"
  ],
  "author": "FuqiangCraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuqiangCraft/dsh-desktop.git"
  },
  "homepage": "https://github.com/FuqiangCraft/dsh-desktop#readme",
  "bugs": {
    "url": "https://github.com/FuqiangCraft/dsh-desktop/issues"
  },
  "devDependencies": {
    "oxlint": "^1.14.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  }
}
