{
  "name": "deepseek-harness-desktop-pro",
  "version": "1.0.8",
  "private": true,
  "description": "The Ultimate Next-Generation Desktop Plugin & Native Client for DeepSeek Harness",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:plugin": "pnpm --filter @mixian/dsh-desktop-plugin dev",
    "dev": "node packages/dsh-desktop-rust/scripts/dev.mjs",
    "tauri:dev": "node packages/dsh-desktop-rust/scripts/dev.mjs",
    "tauri:typecheck": "cargo check -p dsh-desktop-host --features tauri-shell",
    "tauri:test": "cargo test -p dsh-desktop-host --features tauri-shell",
    "tauri:prepare": "node packages/dsh-desktop-rust/scripts/prepare-runtime.mjs",
    "tauri:package": "pnpm exec tauri build --config packages/dsh-desktop-rust/tauri.conf.json",
    "lint": "oxlint --ignore-pattern '**/lib/**' --ignore-pattern '**/target/**' .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "node --test test/license.test.mjs test/metadata.test.mjs test/installer.test.mjs test/profile-patch.test.mjs packages/dsh-desktop-plugin/test/locales.test.mjs packages/dsh-desktop-plugin/test/config.test.mjs packages/dsh-desktop-plugin/test/screen-capture.test.mjs packages/dsh-desktop-plugin/test/notifier.test.mjs packages/dsh-desktop-plugin/test/settings.test.mjs packages/dsh-desktop-plugin/test/pet-state.test.mjs packages/dsh-desktop-plugin/test/workspace-picker.test.mjs packages/dsh-desktop-plugin/test/sound.test.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:runtime-closure": "node scripts/verify-runtime-closure.mjs",
    "verify:package-size": "node scripts/verify-package-size.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm tauri:prepare && pnpm tauri:typecheck && pnpm tauri:test && pnpm --filter @mixian/dsh-desktop-plugin build && pnpm verify:bundle && pnpm verify:runtime-closure && pnpm verify:package-size"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "desktop",
    "raycast",
    "agent"
  ],
  "author": "FuqiangCraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuqiangCraft/dsh-desktop.git"
  },
  "homepage": "https://github.com/FuqiangCraft/dsh-desktop#readme",
  "bugs": {
    "url": "https://github.com/FuqiangCraft/dsh-desktop/issues"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "oxlint": "^1.14.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  }
}
