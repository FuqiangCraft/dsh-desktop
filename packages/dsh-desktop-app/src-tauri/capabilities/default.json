{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Grants the main, pet, and built-in pet settings windows access to the app's IPC commands from local pages and the embedded dsh web UI (remote origin http://127.0.0.1:3080).",
  "windows": ["main", "pet", "pet-settings"],
  "remote": {
    "urls": ["http://127.0.0.1:3080/*"]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "allow-sync-recent-sessions",
    "allow-retry-spawn-dsh",
    "allow-sync-desktop-settings",
    "allow-get-desktop-settings",
    "allow-get-pet-resource-path",
    "allow-open-pet-resource-folder",
    "allow-list-pet-resources",
    "allow-read-pet-resource",
    "allow-update-pet-state",
    "allow-start-dragging-pet",
    "allow-check-for-updates"
  ]
}
