{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "1.0.5",
  "identifier": "com.deepseek.harness.desktop",
  "build": {
    "beforeBuildCommand": "node packages/dsh-desktop-rust/scripts/prepare-runtime.mjs",
    "frontendDist": "assets"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["dsh-remote", "pet-local"]
    },
    "windows": []
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FuqiangCraft/dsh-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyOUI5RDYyQUUxODhCRUEKUldUcWl4aXVZcDJiOGdzb1IvYUkzQnJGa21jek1ZSlh1UzRwdEZOTEYwV29VZDRucTRwVndpN0MK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["../../assets/branding/icon.ico"],
    "resources": {
      "../../.tauri-runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
